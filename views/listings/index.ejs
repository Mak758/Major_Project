<% layout("/layouts/boilerplate") %>

    <style>
    /* Main filter row */
    #filters {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        gap: 1rem;
        width: 100%;
        min-width: 0;
        padding-top: 1rem;
    }

    /* Horizontal category scrolling */
    .category-scroll {
        display: flex;
        flex: 1 1 auto;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        gap: 2rem;

        width: 0;
        min-width: 0;

        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;

        scrollbar-width: thin;
        scrollbar-color: #999 transparent;
        -webkit-overflow-scrolling: touch;
    }

    /* Scrollbar track */
    .category-scroll::-webkit-scrollbar {
        height: 6px;
    }

    .category-scroll::-webkit-scrollbar-track {
        background: #eee;
        border-radius: 20px;
    }

    /* Scrollbar thumb */
    .category-scroll::-webkit-scrollbar-thumb {
        background: #999;
        border-radius: 20px;
    }

    .category-scroll::-webkit-scrollbar-thumb:hover {
        background: #666;
    }

    /* Category icons */
    .filter {
        flex: 0 0 auto;
        min-width: 75px;
        text-align: center;
        margin: 0;
        opacity: 0.7;
        text-decoration: none;
        color: inherit;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
        margin: 0.5rem 0 0;
    }

    .filter i {
        font-size: 1.2rem;
    }

    /* Tax information */
    .tax-info {
        display: none;
    }

    /* Tax toggle */
    .tax-toggle {
        flex: 0 0 auto;
        border: 1px solid black;
        border-radius: 1rem;
        min-height: 2.25rem;
        padding: 0.75rem 1rem;
        margin: 0;
        display: flex;
        align-items: center;
        background: white;
    }

    .tax-toggle .form-check {
        margin-bottom: 0;
    }

    /* Mobile */
    @media (max-width: 768px) {
        #filters {
            gap: 0.5rem;
        }

        .category-scroll {
            gap: 1.25rem;
        }

        .tax-toggle {
            padding: 0.5rem;
        }

        .tax-toggle .form-check-label {
            font-size: 0.7rem;
        }
    }
    </style>

    <div id="filters">

        <div class="category-scroll">
            <a href="/listings?category=Trending" class="filter text-decoration-none text-dark">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </a>

            <a href="/listings?category=Rooms" class="filter text-decoration-none text-dark">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </a>

            <a href="/listings?category=Iconic%20cities" class="filter text-decoration-none text-dark">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic cities</p>
            </a>

            <a href="/listings?category=Mountains" class="filter text-decoration-none text-dark">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </a>

            <a href="/listings?category=Castles" class="filter text-decoration-none text-dark">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </a>

            <a href="/listings?category=Amazing%20Pools" class="filter text-decoration-none text-dark">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools</p>
            </a>

            <a href="/listings?category=Camping" class="filter text-decoration-none text-dark">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </a>

            <a href="/listings?category=Farms" class="filter text-decoration-none text-dark">
                <div><i class="fa-solid fa-building-wheat"></i></div>
                <p>Farms</p>
            </a>

            <a href="/listings?category=Arctic" class="filter text-decoration-none text-dark">
                <div><i class="fa-regular fa-snowflake"></i></div>
                <p>Arctic</p>
            </a>
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input
                    class="form-check-input"
                    type="checkbox"
                    role="switch"
                    id="switchCheckDefault"
                />
                <label class="form-check-label" for="switchCheckDefault">
                    Display total after Taxes
                </label>
            </div>
        </div>

    </div>

    <!-- Sorting Dropdown -->
    <div class="d-flex justify-content-end align-items-center mt-3">
        <form action="/listings" method="GET" class="d-flex align-items-center gap-2">

            <% if (q) { %>
                <input type="hidden" name="q" value="<%= q %>">
            <% } %>

            <% if (category) { %>
                <input type="hidden" name="category" value="<%= category %>">
            <% } %>

            <label for="sort" class="form-label mb-0">Sort By:</label>

            <select
                name="sort"
                id="sort"
                class="form-select"
                style="width: 190px;"
                onchange="this.form.submit()"
            >
                <option value="newest" <%= sort === "newest" ? "selected" : "" %>>
                    Newest First
                </option>

                <option value="price-asc" <%= sort === "price-asc" ? "selected" : "" %>>
                    Price: Low to High
                </option>

                <option value="price-desc" <%= sort === "price-desc" ? "selected" : "" %>>
                    Price: High to Low
                </option>
            </select>
        </form>
    </div>

    <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for (let listing of allListings) { %>

        <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">

            <img 
            src="<%= listing.image.url %>" 
            class="card-img-top" 
            alt="listing_image" 
            style="height: 20rem;"
            />
            <div class="card-img-overlay">Mohd Alam</div>

            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b><br>
                    Price: &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                    <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
                </p>
            </div>
        </div>
        </a>   

    <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <nav aria-label="Listings pagination" class="mt-4">
            <ul class="pagination justify-content-center">

                <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link"
                            href="/listings?<%= new URLSearchParams({
                                q,
                                category,
                                sort,
                                page: currentPage - 1
                            }).toString() %>">
                            Previous
                        </a>
                    </li>
                <% } %>

                <% for (let page = 1; page <= totalPages; page++) { %>
                    <li class="page-item <%= currentPage === page ? 'active' : '' %>">
                        <a class="page-link"
                            href="/listings?<%= new URLSearchParams({
                                q,
                                category,
                                sort,
                                page
                            }).toString() %>">
                            <%= page %>
                        </a>
                    </li>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link"
                            href="/listings?<%= new URLSearchParams({
                                q,
                                category,
                                sort,
                                page: currentPage + 1
                            }).toString() %>">
                            Next
                        </a>
                    </li>
                <% } %>
            </ul>
        </nav>
    <% } %>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for(info of taxInfo) {
                if(info.style.display != "inline") {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        });
    </script>